<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyName>PanacheUI</AssemblyName>
    <RootNamespace>PanacheUI</RootNamespace>
    <Version>0.1.6</Version>

    <!-- Build straight into the repo root, which IS the folder Dalamud loads from and
         the folder every consumer's $(PanacheUIPath) points at. Same one-folder layout
         as GlamourDresserHelper / PhybLab / ClaudePlugin. There is no separate deploy
         step and no second copy of the plugin to drift out of sync. -->
    <OutputPath>../</OutputPath>
    <OutDir>../</OutDir>
  </PropertyGroup>

  <PropertyGroup>
    <DalamudLibPath>$(APPDATA)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
  </PropertyGroup>

  <!-- Dalamud references — Private=false, Dalamud provides these at runtime -->
  <ItemGroup>
    <Reference Include="Dalamud"                HintPath="$(DalamudLibPath)Dalamud.dll"                Private="false" />
    <Reference Include="Dalamud.Common"         HintPath="$(DalamudLibPath)Dalamud.Common.dll"         Private="false" />
    <Reference Include="Dalamud.Bindings.ImGui" HintPath="$(DalamudLibPath)Dalamud.Bindings.ImGui.dll" Private="false" />
    <Reference Include="Newtonsoft.Json"        HintPath="$(DalamudLibPath)Newtonsoft.Json.dll"        Private="false" />
    <Reference Include="Serilog"               HintPath="$(DalamudLibPath)Serilog.dll"               Private="false" />
  </ItemGroup>

  <!-- SkiaSharp — must match Umbra's native libSkiaSharp.dll (v118) already in the process.
       Using 3.118.0-preview.1.2 to be compatible with the version Umbra ships. -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp"                    Version="3.118.0-preview.1.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.118.0-preview.1.2" />
  </ItemGroup>

  <!-- The managed SkiaSharp.dll already lands next to PanacheUI.dll as a package
       reference, but the native library arrives under runtimes/win-x64/native/. Lift it
       to the plugin root so consumers copying $(PanacheUIPath)libSkiaSharp.dll — and
       Dalamud's own resolver — can find it without Umbra having loaded it first. -->
  <Target Name="FlattenNativeSkia" AfterTargets="Build">
    <Copy
      SourceFiles="$(OutDir)runtimes\win-x64\native\libSkiaSharp.dll"
      DestinationFolder="$(OutDir)"
      OverwriteReadOnlyFiles="true"
      SkipUnchangedFiles="true"
      Condition="Exists('$(OutDir)runtimes\win-x64\native\libSkiaSharp.dll')"
    />
  </Target>
</Project>
