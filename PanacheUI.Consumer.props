<!--
  PanacheUI consumer payload — import this from a consuming plugin's .csproj:

      <Import Project="$(APPDATA)\XIVLauncher\devPlugins\PanacheUI\PanacheUI.Consumer.props" />

  WHY THIS FILE EXISTS

  PanacheUI is VENDORED, not shared. Dalamud gives every plugin its own
  PluginLoadContext, and that context resolves managed DLLs only from the plugin's
  own folder. A user who installs PanacheUI from its pluginmaster gets PanacheUI as
  a standalone plugin in ITS folder — which does nothing for your plugin's ALC. If
  your zip does not carry its own copy of PanacheUI.dll, your plugin throws
  FileNotFoundException on the first PanacheUI type it touches, for every user,
  while working perfectly on a dev machine that happens to have devPlugins\PanacheUI.

  So every consumer ships its own copy of:

      PanacheUI.dll  SkiaSharp.dll  libSkiaSharp.dll  Icons\*.png   (+ Themes\ if used)

  That is ~10 MB per plugin, almost all of it the native Skia binary, and it is the
  correct trade: the alternative is asking a non-technical user to install a second
  plugin in the right order and hope the load order holds.

  This file does the build-time half. The RELEASE half is your CI's Package step —
  see CONSUMERS.md next to this file for the snippet, and note that copying to
  $(TargetDir) here is what lets your CI package the payload straight out of the
  build output.

  KNOBS (set any of these BEFORE the Import to override)
    PanacheUIPath           where to vendor from. Default: devPlugins\PanacheUI\
    PanacheDeployPath       dev-plugin folder to mirror into. Default: devPlugins\$(AssemblyName)\
    PanacheIncludeThemes    'true' to also vendor Themes\. Default: false — only set it
                            if you actually load PanacheUI themes; it is ~770 KB.
    PanacheIncludeIcons     'false' to skip the ~4.3 MB Icons\ payload. Default: true.
                            ONLY set this false if the plugin calls neither PUI.Icon NOR
                            PUI.CloseButton — CloseButton renders icon #0005 internally, so
                            "I never call PUI.Icon" is not sufficient reason to opt out. Get
                            this wrong and the UI silently renders grey placeholder boxes.
    PanacheUIMinimumVersion e.g. '0.1.6'. When set, the build FAILS if the vendored
                            PanacheUI.dll is older. Set it to the version whose features you
                            actually use — see CONSUMERS.md "Version pinning".
-->
<Project>

  <PropertyGroup>
    <PanacheUIPath Condition="'$(PanacheUIPath)' == ''">$(APPDATA)\XIVLauncher\devPlugins\PanacheUI\</PanacheUIPath>
    <PanacheDeployPath Condition="'$(PanacheDeployPath)' == ''">$(APPDATA)\XIVLauncher\devPlugins\$(AssemblyName)\</PanacheDeployPath>
    <PanacheIncludeThemes Condition="'$(PanacheIncludeThemes)' == ''">false</PanacheIncludeThemes>
    <PanacheIncludeIcons Condition="'$(PanacheIncludeIcons)' == ''">true</PanacheIncludeIcons>
  </PropertyGroup>

  <!-- Private="false": these are copied explicitly by PanacheVendorPayload below rather
       than by the reference-copy machinery, so the dev deploy and the CI payload are
       driven by exactly one list that is visible in one place. -->
  <ItemGroup>
    <Reference Include="PanacheUI" HintPath="$(PanacheUIPath)PanacheUI.dll" Private="false" />
    <Reference Include="SkiaSharp" HintPath="$(PanacheUIPath)SkiaSharp.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PanacheVendoredLib Include="$(PanacheUIPath)PanacheUI.dll" />
    <PanacheVendoredLib Include="$(PanacheUIPath)SkiaSharp.dll" />
    <PanacheVendoredLib Include="$(PanacheUIPath)libSkiaSharp.dll" />
  </ItemGroup>

  <!-- Fail at BUILD time, not at the user's first click. A missing PanacheUIPath used to
       surface as CS0246 from the compiler, which at least stopped the build; a missing
       libSkiaSharp or Icons folder surfaced as nothing at all locally and a broken UI in
       the wild. See devPlugins/BROKEN.md, "Shipping a data folder that only exists in the
       dev layout". -->
  <Target Name="PanacheVendorCheck" BeforeTargets="Build">
    <Error Condition="!Exists('$(PanacheUIPath)PanacheUI.dll')"
           Text="PanacheUI not found at '$(PanacheUIPath)'. Clone it to devPlugins\PanacheUI, or in CI extract https://github.com/Sansflaire/PanacheUI/releases/latest/download/PanacheUI.zip there. See CONSUMERS.md." />
    <Error Condition="!Exists('$(PanacheUIPath)libSkiaSharp.dll')"
           Text="libSkiaSharp.dll missing from '$(PanacheUIPath)'. PanacheUI v0.1.6+ ships it flat at the zip root; an older zip only has it under runtimes\win-x64\native\." />
    <Error Condition="'$(PanacheIncludeIcons)' == 'true' AND !Exists('$(PanacheUIPath)Icons')"
           Text="Icons folder missing from '$(PanacheUIPath)'. Without it every PUI.Icon and PUI.CloseButton renders as a grey placeholder swatch." />
  </Target>

  <!-- Version floor. Reads the real assembly version out of the vendored DLL rather than
       trusting a file name or a hand-maintained note, so "which PanacheUI did this plugin
       actually build against?" has one answer and it is the binary's own.

       [MSBuild]::VersionGreaterThanOrEquals is used rather than System.Version.CompareTo
       because the two sides routinely differ in field count — the assembly reports 0.1.6.0
       and a human writes 0.1.6 — and System.Version treats an absent revision as -1, which
       makes 0.1.6 compare LESS than 0.1.6.0 and fails the check on an exact match. -->
  <Target Name="PanacheVersionCheck" BeforeTargets="Build" DependsOnTargets="PanacheVendorCheck"
          Condition="'$(PanacheUIMinimumVersion)' != ''">
    <GetAssemblyIdentity AssemblyFiles="$(PanacheUIPath)PanacheUI.dll">
      <Output TaskParameter="Assemblies" ItemName="_PanacheAssemblyId" />
    </GetAssemblyIdentity>
    <PropertyGroup>
      <PanacheUIResolvedVersion>%(_PanacheAssemblyId.Version)</PanacheUIResolvedVersion>
    </PropertyGroup>
    <Error Condition="!$([MSBuild]::VersionGreaterThanOrEquals('$(PanacheUIResolvedVersion)', '$(PanacheUIMinimumVersion)'))"
           Text="PanacheUI $(PanacheUIResolvedVersion) at '$(PanacheUIPath)' is older than the required $(PanacheUIMinimumVersion). Update it: https://github.com/Sansflaire/PanacheUI/releases/latest/download/PanacheUI.zip" />
    <Message Importance="high" Text="PanacheUI $(PanacheUIResolvedVersion) (minimum $(PanacheUIMinimumVersion)) OK" />
  </Target>

  <!-- SkipUnchangedFiles matters here: libSkiaSharp is ~9.6 MB and would otherwise be
       recopied on every incremental build. -->
  <Target Name="PanacheVendorPayload" AfterTargets="Build">
    <!-- Icon selection.
           no <PanacheIcon> items  -> ship all 167 (~3.9 MB). Safe default.
           <PanacheIcon Include=".."> -> ship only those IDs.
           PanacheIncludeIcons=false  -> ship none.

         Subsetting is DECLARATIVE on purpose. Auto-detecting used icons from source was
         tried and does not work on this codebase: call sites read PUI.Icon(Ico.Close), not
         PUI.Icon(5), and a grep for `const int X = N` across a project also hoovers up every
         unrelated timeout and pixel size. Under-detecting ships a plugin whose icons are
         silently grey boxes, so the only safe automation is none — you list what you use.

         A declared ID with no matching PNG is a hard error rather than a shrug: a typo'd
         subset is exactly the silent-placeholder failure this whole mechanism exists to
         prevent, and it should not survive the build that introduced it. -->
    <ItemGroup Condition="'$(PanacheIncludeIcons)' == 'true'">
      <PanacheVendoredIcon Include="$(PanacheUIPath)Icons\*.png" Condition="'@(PanacheIcon)' == ''" />
      <_PanacheIconPadded Include="@(PanacheIcon)" Condition="'@(PanacheIcon)' != ''">
        <File>$(PanacheUIPath)Icons\$([System.String]::Format('{0:0000}', $([System.Convert]::ToInt32('%(Identity)')))).png</File>
      </_PanacheIconPadded>
      <PanacheVendoredIcon Include="@(_PanacheIconPadded->'%(File)')" Condition="'@(PanacheIcon)' != ''" />
    </ItemGroup>

    <Error Condition="'$(PanacheIncludeIcons)' == 'true' AND '@(PanacheVendoredIcon)' == ''"
           Text="No icons found in '$(PanacheUIPath)Icons'. Every PUI.Icon and PUI.CloseButton would render as a placeholder." />

    <Error Condition="'$(PanacheIncludeIcons)' == 'true' AND '@(PanacheIcon)' != '' AND !Exists('%(PanacheVendoredIcon.FullPath)')"
           Text="Declared icon %(PanacheVendoredIcon.Filename) has no PNG in '$(PanacheUIPath)Icons'. Fix the PanacheIcon list - a wrong ID renders as a silent grey placeholder at runtime." />

    <!-- Into the build output, so a CI Package step can take the payload from $(TargetDir). -->
    <Copy SourceFiles="@(PanacheVendoredLib)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="@(PanacheVendoredIcon)" DestinationFolder="$(TargetDir)Icons\" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" Condition="'$(PanacheIncludeIcons)' == 'true'" />
    <Copy SourceFiles="@(PanacheVendoredTheme)" DestinationFolder="$(TargetDir)Themes\%(RecursiveDir)" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" Condition="'$(PanacheIncludeThemes)' == 'true'" />

    <!-- And into the dev-plugin folder, so the loaded plugin matches what users will get. -->
    <Copy SourceFiles="@(PanacheVendoredLib)" DestinationFolder="$(PanacheDeployPath)" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" Condition="Exists('$(PanacheDeployPath)')" />
    <Copy SourceFiles="@(PanacheVendoredIcon)" DestinationFolder="$(PanacheDeployPath)Icons\" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" Condition="'$(PanacheIncludeIcons)' == 'true' AND Exists('$(PanacheDeployPath)')" />
    <Copy SourceFiles="@(PanacheVendoredTheme)" DestinationFolder="$(PanacheDeployPath)Themes\%(RecursiveDir)" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" Condition="'$(PanacheIncludeThemes)' == 'true' AND Exists('$(PanacheDeployPath)')" />

    <!-- Prune icons that are no longer wanted. Copy-only leaves whatever a previous build put
         there, so shrinking a subset (or turning icons off) would otherwise keep shipping the
         old full set out of the dev-plugin folder, which is never cleaned. CI starts from an
         empty output directory and does not need this; a developer's machine very much does,
         and "it was 3.9 MB on my disk but 550 KB in CI" is the kind of divergence that makes a
         packaging bug hard to see.

         Scoped deliberately tightly: only files matching PanacheUI's own 4-digit NNNN.png
         naming, only inside the Icons folder, and only ones absent from the wanted list. A
         plugin's own artwork does not use that shape and is never touched. -->
    <ItemGroup>
      <_PanacheIconOnDisk Include="$(TargetDir)Icons\????.png" />
      <_PanacheIconOnDisk Include="$(PanacheDeployPath)Icons\????.png" Condition="Exists('$(PanacheDeployPath)')" />
      <!-- The destination paths the copies above just wrote. Excluding by full path is what
           makes this correct; an earlier attempt excluded via a nested %(...) metadata
           reference inside a transform, which MSBuild evaluates to nothing — so every icon
           counted as stale and the prune deleted the entire set it had just copied. -->
      <_PanacheIconWanted Include="@(PanacheVendoredIcon->'$(TargetDir)Icons\%(Filename)%(Extension)')" />
      <_PanacheIconWanted Include="@(PanacheVendoredIcon->'$(PanacheDeployPath)Icons\%(Filename)%(Extension)')" Condition="Exists('$(PanacheDeployPath)')" />
      <_PanacheIconStale Include="@(_PanacheIconOnDisk)" Exclude="@(_PanacheIconWanted)" />
    </ItemGroup>
    <Delete Files="@(_PanacheIconStale)" ContinueOnError="WarnAndContinue" Condition="'@(_PanacheIconStale)' != ''" />
    <Message Importance="normal" Text="PanacheUI pruned @(_PanacheIconStale->Count()) stale icon(s)" Condition="'@(_PanacheIconStale)' != ''" />

    <Message Importance="high" Text="PanacheUI vendored: @(PanacheVendoredLib->Count()) libs, @(PanacheVendoredIcon->Count()) icons -> $(TargetDir)" />
  </Target>

</Project>
